rules_version = '2';

// Firestore security rules for the Casa Vazquez "live availability" feature.
//
// How to apply:
//   Firebase Console -> Firestore Database -> tab "Regeln" ("Rules")
//   -> paste this content -> "Veröffentlichen" ("Publish").
//
// This replaces the temporary "test mode" rules (which allow anyone to
// read/write until a fixed expiry date) with permanent rules that:
//   - let the public website read availability data (needed so guests'
//     browsers can see which items are currently sold out), and
//   - only allow writes from a logged-in admin (the account created in
//     Firebase Authentication), which is what the /admin/verfuegbarkeit
//     page uses.
service cloud.firestore {
  match /databases/{database}/documents {
    match /availability/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
