# Firebase config for the availability toggle feature.
# Values come from Firebase Console > Project settings > General > "Your apps" > Web app.
# These are public client identifiers (not secrets) and are safe to expose in the built frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
